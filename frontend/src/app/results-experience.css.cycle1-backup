.result-page {
  --result-border: #e2e0e8;
  --result-border-soft: #eeecf2;
  --result-purple: #5b3fd1;
  --result-purple-strong: #4328b4;
  --result-purple-soft: #f1edff;
  --result-green: #24704d;
  --result-green-soft: #e8f5ee;
  --result-amber: #8a570d;
  --result-amber-soft: #fff4dd;
  display: grid;
  gap: 18px;
  padding-top: 34px;
}

.result-page-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 28px;
  padding: 0 2px 6px;
}

.result-page-header h1 {
  margin: 4px 0 5px;
  color: var(--ink);
  font-size: clamp(30px, 3vw, 42px);
  line-height: 1.05;
  letter-spacing: -0.045em;
}

.result-page-header > div > p:last-child {
  max-width: 660px;
  margin: 0;
  color: var(--muted);
  font-size: 15px;
  line-height: 1.55;
}

.result-method-label {
  margin: 0;
  color: var(--result-purple);
  font-size: 12px;
  font-weight: 760;
  letter-spacing: 0.015em;
}

.result-page-actions,
.result-state-actions {
  display: flex;
  align-items: center;
  gap: 9px;
}

.result-action {
  display: inline-flex;
  min-height: 42px;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 0 16px;
  border: 1px solid var(--result-border);
  border-radius: 10px;
  background: #fff;
  color: var(--ink);
  font-size: 13px;
  font-weight: 720;
  text-decoration: none;
  transition:
    border-color 160ms var(--ease-out),
    background-color 160ms var(--ease-out),
    color 160ms var(--ease-out),
    transform 160ms var(--ease-out);
}

.result-action-primary {
  border-color: var(--result-purple);
  background: var(--result-purple);
  color: #fff;
}

@media (hover: hover) and (pointer: fine) {
  .result-action:hover {
    border-color: var(--accent-muted);
    background: var(--result-purple-soft);
    color: var(--result-purple-strong);
    transform: translateY(-1px);
  }

  .result-action-primary:hover {
    border-color: var(--result-purple-strong);
    background: var(--result-purple-strong);
    color: #fff;
  }
}

.result-action:active,
.result-inline-link:active,
.result-technical-link:active {
  transform: scale(0.975);
}

.result-summary {
  display: grid;
  min-height: 258px;
  grid-template-columns: minmax(300px, 0.92fr) minmax(560px, 1.55fr);
  overflow: hidden;
  border: 1px solid #dcd5fa;
  border-radius: 16px;
  background: #fff;
}

.result-summary-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  justify-content: center;
  padding: 34px 32px;
  border-right: 1px solid var(--result-border-soft);
  background: #fbfaff;
}

.result-status {
  display: flex;
  align-items: center;
  gap: 7px;
  margin: 0 0 14px;
  color: var(--result-purple);
  font-size: 12px;
  font-weight: 780;
}

.result-summary-caution .result-status {
  color: var(--result-amber);
}

.result-summary-copy h2 {
  max-width: 580px;
  margin: 0;
  color: var(--ink);
  font-size: clamp(24px, 2.45vw, 36px);
  line-height: 1.12;
  letter-spacing: -0.04em;
}

.result-metadata {
  display: flex;
  flex-wrap: wrap;
  gap: 9px 18px;
  margin: 24px 0 0;
}

.result-metadata > div {
  display: flex;
  align-items: baseline;
  gap: 6px;
}

.result-metadata dt {
  color: var(--ink-subtle);
  font-size: 12px;
  font-weight: 700;
}

.result-uncertainty {
  margin: 12px 0 0;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.45;
}

.result-summary-metrics {
  display: grid;
  min-width: 0;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.result-summary .hero-metric {
  display: flex;
  min-width: 0;
  flex-direction: column;
  justify-content: center;
  padding: 28px 30px;
  border-bottom: 1px solid var(--result-border-soft);
  text-align: left;
}

.result-summary .hero-metric:nth-child(odd) {
  border-right: 1px solid var(--result-border-soft);
}

.result-summary .hero-metric:nth-last-child(-n + 2) {
  border-bottom: 0;
}

.result-summary .hero-metric > span {
  color: var(--muted);
  font-size: 12px;
  font-weight: 650;
}

.result-summary .hero-metric strong {
  display: block;
  overflow-wrap: anywhere;
  margin: 8px 0 6px;
  color: var(--result-purple);
  font-size: clamp(28px, 3vw, 43px);
  line-height: 1;
  letter-spacing: -0.045em;
}

.result-summary .hero-metric strong.hero-metric-text {
  max-width: 260px;
  color: var(--ink);
  font-size: clamp(18px, 1.8vw, 24px);
  line-height: 1.12;
  letter-spacing: -0.025em;
}

.result-summary .hero-metric strong.design-valid {
  color: var(--result-green);
}

.result-summary .hero-metric strong.design-weak,
.result-summary .hero-metric strong.design-invalid {
  color: var(--result-amber);
}

.result-summary .hero-metric small {
  max-width: 280px;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.4;
}

.result-recommendation {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 16px;
  min-height: 92px;
  padding: 19px 22px;
  border: 1px solid var(--result-border);
  border-left-width: 3px;
  border-radius: 14px;
  background: #fff;
}

.result-recommendation.is-ready {
  border-left-color: var(--result-green);
}

.result-recommendation.is-caution {
  border-left-color: var(--result-amber);
}

.result-recommendation-icon {
  display: inline-flex;
  width: 42px;
  height: 42px;
  align-items: center;
  justify-content: center;
  border-radius: 11px;
  background: var(--result-purple-soft);
  color: var(--result-purple);
}

.result-recommendation.is-ready .result-recommendation-icon {
  background: var(--result-green-soft);
  color: var(--result-green);
}

.result-recommendation.is-caution .result-recommendation-icon {
  background: var(--result-amber-soft);
  color: var(--result-amber);
}

.result-recommendation p {
  margin: 0 0 3px;
  color: var(--muted);
  font-size: 11px;
  font-weight: 700;
}

.result-recommendation h2 {
  margin: 0 0 3px;
  color: var(--ink);
  font-size: 16px;
  letter-spacing: -0.018em;
}

.result-recommendation div > span {
  color: var(--muted);
  font-size: 12px;
  line-height: 1.45;
}

.result-inline-link,
.result-technical-link {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: var(--result-purple);
  font-size: 12px;
  font-weight: 750;
  text-decoration: none;
  transition:
    color 160ms var(--ease-out),
    transform 160ms var(--ease-out);
}

@media (hover: hover) and (pointer: fine) {
  .result-inline-link:hover,
  .result-technical-link:hover {
    color: var(--result-purple-strong);
  }
}

.result-evidence-strip {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  overflow: hidden;
  border: 1px solid var(--result-border);
  border-radius: 14px;
  background: #fff;
}

.result-evidence-metric {
  display: grid;
  min-width: 0;
  grid-template-columns: auto minmax(0, 1fr);
  gap: 13px;
  align-items: center;
  padding: 21px 24px;
  border-right: 1px solid var(--result-border-soft);
}

.result-evidence-metric:last-child {
  border-right: 0;
}

.result-evidence-icon {
  display: inline-flex;
  width: 40px;
  height: 40px;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  background: var(--result-purple-soft);
  color: var(--result-purple);
}

.result-evidence-metric div {
  display: grid;
  min-width: 0;
}

.result-evidence-metric span:not(.result-evidence-icon) {
  color: var(--muted);
  font-size: 11px;
  font-weight: 650;
}

.result-evidence-metric strong {
  overflow-wrap: anywhere;
  margin-top: 3px;
  color: var(--ink);
  font-size: 20px;
  letter-spacing: -0.025em;
}

.result-evidence-metric small {
  margin-top: 3px;
  color: var(--muted);
  font-size: 10px;
}

.result-chart-grid,
.result-detail-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.result-chart-panel,
.result-diagnostics,
.result-technical {
  min-width: 0;
  border: 1px solid var(--result-border);
  border-radius: 14px;
  background: #fff;
}

.result-chart-panel {
  overflow: hidden;
  padding: 24px 24px 18px;
}

.result-panel-heading {
  display: flex;
  min-height: 55px;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 14px;
}

.result-panel-heading h2 {
  margin: 0 0 5px;
  color: var(--ink);
  font-size: 16px;
  letter-spacing: -0.025em;
}

.result-panel-heading p {
  margin: 0;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.45;
}

.result-legend {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 5px;
  color: var(--muted);
  font-size: 10px;
  white-space: nowrap;
}

.result-legend i {
  display: inline-block;
  width: 8px;
  height: 8px;
  margin-left: 6px;
  border-radius: 2px;
  background: var(--result-purple);
}

.result-legend i.counterfactual {
  background: #72b79b;
}

.result-chart-panel .comparison-chart,
.result-chart-panel .event-study {
  min-height: 245px;
}

.result-chart-note {
  margin: 14px 0 0;
  padding: 11px 13px;
  border-radius: 9px;
  background: #f8f6ff;
  color: #5f5871;
  font-size: 11px;
  line-height: 1.45;
}

.result-detail-grid {
  margin-bottom: 16px;
}

.result-diagnostics {
  padding: 24px;
}

.result-detail-title {
  display: flex;
  gap: 12px;
  align-items: flex-start;
}

.result-detail-title > span {
  display: inline-flex;
  width: 38px;
  height: 38px;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  background: var(--result-purple-soft);
  color: var(--result-purple);
}

.result-diagnostics.is-ready .result-detail-title > span {
  background: var(--result-green-soft);
  color: var(--result-green);
}

.result-diagnostics.is-caution .result-detail-title > span {
  background: var(--result-amber-soft);
  color: var(--result-amber);
}

.result-detail-title p {
  margin: 0 0 4px;
  color: var(--muted);
  font-size: 11px;
  font-weight: 650;
}

.result-detail-title h2 {
  margin: 0;
  color: var(--ink);
  font-size: 18px;
  letter-spacing: -0.025em;
}

.result-diagnostics ul {
  display: grid;
  gap: 8px;
  margin: 22px 0 0;
  padding-left: 20px;
  color: var(--ink-subtle);
  font-size: 13px;
  line-height: 1.5;
}

.result-diagnostic-clear {
  margin: 22px 0 0;
  color: var(--result-green);
  font-size: 13px;
  font-weight: 650;
}

.result-assumption {
  margin-top: 22px;
  padding-top: 18px;
  border-top: 1px solid var(--result-border-soft);
}

.result-assumption h3 {
  margin: 0 0 6px;
  color: var(--ink);
  font-size: 13px;
}

.result-assumption p {
  margin: 0;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.55;
}

.result-technical.technical {
  align-self: stretch;
  margin: 0;
  padding: 0 24px 22px;
  border-radius: 14px;
  background: #fff;
}

.result-technical summary {
  position: relative;
  padding: 24px 24px 20px 0;
  list-style: none;
  color: var(--ink);
  font-size: 18px;
  font-weight: 760;
  letter-spacing: -0.025em;
}

.result-technical summary::-webkit-details-marker {
  display: none;
}

.result-technical summary::after {
  position: absolute;
  top: 22px;
  right: 0;
  color: var(--muted);
  content: "+";
  font-size: 22px;
  font-weight: 500;
  transition: transform 160ms var(--ease-out);
}

.result-technical[open] summary::after {
  transform: rotate(45deg);
}

.result-technical .technical-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1px;
  overflow: hidden;
  padding: 0;
  border: 1px solid var(--result-border-soft);
  border-radius: 10px;
  background: var(--result-border-soft);
}

.result-technical .metric {
  min-height: 94px;
  padding: 17px;
  border: 0;
  border-radius: 0;
  background: #fff;
}

.result-technical .metric span {
  font-size: 10px;
}

.result-technical .metric strong {
  overflow-wrap: anywhere;
  margin-top: 7px;
  font-size: 14px;
  line-height: 1.35;
}

.result-technical-link {
  margin-top: 17px;
}

.result-state-page {
  display: grid;
  min-height: calc(100vh - 126px);
  place-items: center;
  padding: 42px 0 72px;
}

.result-failure-card {
  width: min(100%, 680px);
  padding: 44px;
  border: 1px solid #ebd3ae;
  border-radius: 16px;
  background: #fff;
  text-align: left;
}

.result-failure-icon {
  display: inline-flex;
  width: 50px;
  height: 50px;
  align-items: center;
  justify-content: center;
  margin-bottom: 22px;
  border-radius: 13px;
  background: var(--result-amber-soft);
  color: var(--result-amber);
}

.result-failure-card h1 {
  margin: 7px 0 14px;
  color: var(--ink);
  font-size: clamp(28px, 4vw, 42px);
  letter-spacing: -0.045em;
}

.result-failure-reason {
  margin: 0;
  color: var(--ink);
  font-size: 16px;
  font-weight: 680;
  line-height: 1.5;
}

.result-failure-guidance {
  max-width: 560px;
  margin: 10px 0 0;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.6;
}

.result-failure-attempt {
  display: inline-flex;
  margin: 19px 0 0;
  padding: 6px 9px;
  border-radius: 7px;
  background: var(--surface-hover);
  color: var(--muted);
  font-size: 11px;
  font-weight: 700;
}

.result-failure-card .result-state-actions {
  margin-top: 28px;
}

@media (max-width: 1120px) {
  .result-summary {
    grid-template-columns: 1fr;
  }

  .result-summary-copy {
    border-right: 0;
    border-bottom: 1px solid var(--result-border-soft);
  }
}

@media (max-width: 820px) {
  .result-page {
    padding-top: 24px;
  }

  .result-page-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .result-recommendation {
    grid-template-columns: auto minmax(0, 1fr);
  }

  .result-recommendation .result-inline-link {
    grid-column: 2;
    justify-self: start;
  }

  .result-chart-grid,
  .result-detail-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 620px) {
  .result-page-actions,
  .result-state-actions {
    width: 100%;
    align-items: stretch;
    flex-direction: column;
  }

  .result-action {
    width: 100%;
  }

  .result-summary-copy {
    padding: 28px 23px;
  }

  .result-summary-metrics {
    grid-template-columns: 1fr;
  }

  .result-summary .hero-metric {
    min-height: 132px;
    padding: 23px;
    border-right: 0;
    border-bottom: 1px solid var(--result-border-soft);
  }

  .result-summary .hero-metric:nth-child(odd) {
    border-right: 0;
  }

  .result-summary .hero-metric:nth-last-child(-n + 2) {
    border-bottom: 1px solid var(--result-border-soft);
  }

  .result-summary .hero-metric:last-child {
    border-bottom: 0;
  }

  .result-recommendation {
    grid-template-columns: 1fr;
    padding: 22px;
  }

  .result-recommendation .result-inline-link {
    grid-column: auto;
  }

  .result-evidence-strip {
    grid-template-columns: 1fr;
  }

  .result-evidence-metric {
    border-right: 0;
    border-bottom: 1px solid var(--result-border-soft);
  }

  .result-evidence-metric:last-child {
    border-bottom: 0;
  }

  .result-panel-heading {
    flex-direction: column;
  }

  .result-technical .technical-grid {
    grid-template-columns: 1fr;
  }

  .result-failure-card {
    padding: 30px 24px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .result-action,
  .result-inline-link,
  .result-technical-link,
  .result-technical summary::after {
    transition: none;
  }
}
