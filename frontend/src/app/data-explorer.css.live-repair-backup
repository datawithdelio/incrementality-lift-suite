  background: #fffaf1;
}

.quality-summary-status[data-ready="true"] {
  border-color: #ccebdc;
  background: #f2fbf7;
}

.quality-summary-status > span {
  width: 9px;
  height: 9px;
  flex: 0 0 auto;
  border-radius: 999px;
  background: #db9a23;
  box-shadow: 0 0 0 4px rgb(219 154 35 / 12%);
}

.quality-summary-status[data-ready="true"] > span {
  background: #20a66a;
  box-shadow: 0 0 0 4px rgb(32 166 106 / 12%);
}

.quality-summary-status strong,
.quality-summary-status small {
  display: block;
}

.quality-summary-status strong {
  color: #2b2b34;
  font-size: 0.79rem;
}

.quality-summary-status small {
  margin-top: 2px;
  color: #7b7b88;
  font-size: 0.69rem;
}

.quality-summary-list {
  display: grid;
  padding: 0 14px 14px;
}

.quality-summary-list article {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 10px;
  padding: 12px 2px;
  border-bottom: 1px solid #eeeef3;
}

.quality-summary-list article:last-child {
  border-bottom: 0;
}

.quality-finding-status {
  display: flex;
  min-width: 0;
  align-items: flex-start;
  gap: 9px;
}

.quality-finding-status > span {
  width: 8px;
  height: 8px;
  flex: 0 0 auto;
  margin-top: 5px;
  border-radius: 999px;
  background: #e89c20;
}

article[data-passed="true"] .quality-finding-status > span {
  background: #20a66a;
}

.quality-finding-status strong {
  display: block;
  color: #2c2c35;
  font-size: 0.76rem;
  text-transform: capitalize;
}

.quality-finding-status p {
  overflow: hidden;
  margin: 3px 0 0;
  color: #858592;
  font-size: 0.68rem;
  line-height: 1.35;
  text-overflow: ellipsis;
}

.quality-summary-list article > small {
  color: #8a8a96;
  font-size: 0.66rem;
  font-weight: 700;
}

.quality-summary-list article:not([data-passed="true"]) > small {
  color: #c77a13;
}

.quality-all-checks {
  border-top: 1px solid #eeeef3;
}

.quality-all-checks > summary {
  cursor: pointer;
  list-style: none;
  padding: 14px 16px;
  color: #6547e8;
  font-size: 0.75rem;
  font-weight: 750;
}

.quality-all-checks > summary::-webkit-details-marker {
  display: none;
}

.quality-all-checks[open] > summary {
  border-bottom: 1px solid #eeeef3;
}

.quality-all-checks .finding-list {
  display: grid;
  grid-template-columns: 1fr;
  max-height: 430px;
  gap: 8px;
  overflow: auto;
  margin: 0;
  padding: 12px;
}

.quality-all-checks .finding-list article {
  padding: 12px;
  border: 1px solid #ededf2;
  border-radius: 11px;
}

@media (max-width: 1100px) {
  .explorer-analysis-layout {
    grid-template-columns: 1fr;
  }

  .quality-panel-compact {
    position: static;
  }
}

@media (max-width: 760px) {
  .explorer-chart-panel {
    padding-inline: 10px;
  }

  .explorer-svg-chart {
    min-height: 280px;
  }

  .quality-summary-heading {
    grid-template-columns: 1fr;
  }
}

/* ==========================================================
   PREMIUM DATA EXPLORER — CYCLE 3 REPAIR
   Visible treatment-period labels
   ========================================================== */

.explorer-phase-context {
  display: grid;
  grid-template-columns: 1fr 1fr;
  margin: 10px 24px 0 56px;
  border-bottom: 1px solid #eeeef3;
  color: #7b7b88;
  font-size: 0.68rem;
  font-weight: 750;
  letter-spacing: 0.025em;
}

.explorer-phase-context span {
  padding: 7px 10px;
}

.explorer-phase-context span:last-child {
  border-left: 1px dashed #8b73ef;
  background: rgb(101 71 232 / 7%);
  color: #6547e8;
}

@media (max-width: 760px) {
  .explorer-phase-context {
    margin-left: 40px;
  }
}

/* ==========================================================
   PREMIUM DATA EXPLORER — CYCLE 4
   Final chart and row-table polish
   ========================================================== */

.explorer-chart-panel {
  padding: 14px 16px 16px;
}

.explorer-svg-chart {
  width: 100%;
  height: auto;
  min-height: 0;
  max-height: 315px;
}

.explorer-chart-post {
  fill: rgb(101 71 232 / 11%);
}

.explorer-treatment-marker {
  stroke-width: 2;
  stroke-dasharray: 6 5;
}

.explorer-axis-date {
  font-size: 10px;
  font-weight: 650;
}

.explorer-phase-context {
  margin-top: 0;
  border-top: 1px solid #eeeef3;
}

.explorer-analysis-layout {
  gap: 12px;
  margin-top: 10px;
}

.profile-strip {
  margin-top: 12px;
}

.explorer-table {
  overflow: hidden;
  padding: 0;
}

.explorer-table .explorer-section-heading {
  padding: 20px 22px 16px;
}

.explorer-table .table-scroll {
  border-top: 1px solid #ececf2;
}

.explorer-table table {
  border-collapse: separate;
  border-spacing: 0;
}

.explorer-table th {
  position: sticky;
  top: 0;
  z-index: 2;
  padding: 11px 13px;
  background: #fafafe;
  box-shadow: inset 0 -1px #e9e9ef;
  white-space: nowrap;
}

.explorer-table td {
  padding: 11px 13px;
  white-space: nowrap;
}

.explorer-table tbody tr {
  transition: background 140ms ease;
}

.explorer-table tbody tr:hover {
  background: #faf9ff;
}

@media (max-width: 760px) {
  .explorer-svg-chart {
    max-height: 270px;
  }

  .explorer-table .explorer-section-heading {
    padding-inline: 16px;
  }
}

/* ==========================================================
   PREMIUM DATA EXPLORER — CYCLE 5
   Interactive chart inspection
   ========================================================== */

.explorer-chart-with-context {
  position: relative;
  outline: none;
}

.explorer-chart-with-context:focus-visible {
  border-radius: 12px;
  box-shadow: 0 0 0 3px rgb(101 71 232 / 15%);
}

.explorer-chart-hit-target {
  cursor: crosshair;
  fill: transparent;
  outline: none;
}

.explorer-chart-hit-target:focus {
  fill: rgb(101 71 232 / 5%);
}

.explorer-chart-crosshair {
  pointer-events: none;
  stroke: #6f54e8;
  stroke-width: 1.5;
  stroke-dasharray: 4 4;
}

.explorer-chart-selected-ring {
  pointer-events: none;
  fill: #ffffff;
  stroke-width: 3;
}

.explorer-chart-selected-treatment {
  stroke: var(--explorer-accent);
}

.explorer-chart-selected-control {
  stroke: #45404f;
}

.explorer-chart-tooltip {
  position: absolute;
  z-index: 8;
  top: 84px;
  width: 210px;
  padding: 13px 14px;
  border: 1px solid rgb(255 255 255 / 10%);
  border-radius: 13px;
  background: rgb(27 27 37 / 96%);
  box-shadow:
    0 18px 45px rgb(20 20 30 / 24%),
    0 2px 8px rgb(20 20 30 / 15%);
  color: #ffffff;
  pointer-events: none;
  transform: translateX(-50%);
  backdrop-filter: blur(14px);
}

.explorer-chart-tooltip[data-align="start"] {
  transform: translateX(0);
}

.explorer-chart-tooltip[data-align="end"] {
  transform: translateX(-100%);
}

.explorer-chart-tooltip header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 10px;
}

.explorer-chart-tooltip header strong {
  font-size: 0.79rem;
}

.explorer-chart-tooltip header span {
  padding: 3px 6px;
  border-radius: 999px;
  background: rgb(125 98 255 / 22%);
  color: #cfc3ff;
  font-size: 0.58rem;
  font-weight: 800;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.explorer-chart-tooltip dl {
  display: grid;
  gap: 6px;
  margin: 0;
}

.explorer-chart-tooltip dl div {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
}

.explorer-chart-tooltip dt {
  color: #aaa8b7;
  font-size: 0.68rem;
}

.explorer-chart-tooltip dd {
  margin: 0;
  font-size: 0.72rem;
  font-weight: 750;
}

.explorer-chart-tooltip small {
  display: block;
  margin-top: 10px;
  padding-top: 9px;
  border-top: 1px solid rgb(255 255 255 / 10%);
  color: #9795a5;
  font-size: 0.61rem;
  line-height: 1.4;
}

.explorer-inspection-kpis {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  border-top: 1px solid #ececf2;
  background: linear-gradient(
    90deg,
    rgb(101 71 232 / 5%),
    rgb(101 71 232 / 1%)
  );
}

.explorer-inspection-kpis article {
  min-width: 0;
  padding: 13px 18px;
  border-right: 1px solid #ececf2;
}

.explorer-inspection-kpis article:last-child {
  border-right: 0;
}

.explorer-inspection-kpis span,
.explorer-inspection-kpis strong,
.explorer-inspection-kpis small {
  display: block;
}

.explorer-inspection-kpis span {
  color: #777582;
  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 0.055em;
  text-transform: uppercase;
}

.explorer-inspection-kpis strong {
  margin-top: 5px;
  color: #23232d;
  font-size: 0.98rem;
}

.explorer-inspection-kpis small {
  margin-top: 3px;
  color: #898794;
  font-size: 0.64rem;
}

@media (max-width: 900px) {
  .explorer-inspection-kpis {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .explorer-inspection-kpis article:nth-child(2) {
    border-right: 0;
  }

  .explorer-inspection-kpis article:nth-child(-n + 2) {
    border-bottom: 1px solid #ececf2;
  }
}

@media (max-width: 620px) {
  .explorer-chart-tooltip {
    width: 185px;
  }

  .explorer-inspection-kpis {
    grid-template-columns: 1fr;
  }

  .explorer-inspection-kpis article {
    border-right: 0;
    border-bottom: 1px solid #ececf2;
  }
}

/* ==========================================================
   PREMIUM DATA EXPLORER — CYCLE 6
   Row-level evidence table
   ========================================================== */

.explorer-table {
  overflow: visible;
  border: 1px solid #e7e7ee;
  border-radius: 17px;
  background: #ffffff;
  box-shadow:
    0 1px 2px rgb(20 20 30 / 3%),
    0 12px 34px rgb(20 20 30 / 5%);
}

.explorer-table-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 22px;
  padding: 19px 21px 16px;
}

.explorer-table-heading h2 {
  margin: 4px 0 0;
}

.explorer-table-heading > div:first-child > p:last-child {
  margin: 6px 0 0;
  color: #7d7c88;
  font-size: 0.76rem;
}

.explorer-table-toolbar {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
}

.explorer-columns-menu {
  position: relative;
}

.explorer-columns-menu > summary,
.explorer-table-download {
  display: inline-flex;
  min-height: 36px;
  align-items: center;
  justify-content: center;
  gap: 7px;
  padding: 0 12px;
  border: 1px solid #e3e3eb;
  border-radius: 10px;
  background: #ffffff;
  color: #3d3c47;
  font-size: 0.7rem;
  font-weight: 750;
  text-decoration: none;
  white-space: nowrap;
  cursor: pointer;
  transition:
    border-color 140ms ease,
    background 140ms ease,
    transform 140ms ease;
}

.explorer-columns-menu > summary {
  list-style: none;
}

.explorer-columns-menu > summary::-webkit-details-marker {
  display: none;
}

.explorer-columns-menu > summary:hover,
.explorer-table-download:hover {
  border-color: #cfc7f8;
  background: #faf9ff;
  color: #5f43db;
}

.explorer-columns-menu > summary:active,
.explorer-table-download:active {
  transform: translateY(1px);
}

.explorer-columns-menu > summary small {
  color: #8a8994;
  font-size: 0.61rem;
}

.explorer-columns-popover {
  position: absolute;
  z-index: 20;
  top: calc(100% + 8px);
  right: 0;
  display: grid;
  width: 238px;
  max-height: 330px;
  overflow: auto;
  padding: 8px;
  border: 1px solid #e2e2e9;
  border-radius: 13px;
  background: rgb(255 255 255 / 98%);
  box-shadow:
    0 18px 48px rgb(20 20 30 / 15%),
    0 3px 10px rgb(20 20 30 / 8%);
  backdrop-filter: blur(16px);
}

.explorer-columns-popover header {
  padding: 8px 8px 10px;
  border-bottom: 1px solid #ededf2;
}

.explorer-columns-popover header strong,
.explorer-columns-popover header small {
  display: block;
}

.explorer-columns-popover header strong {
  color: #292832;
  font-size: 0.75rem;
}

.explorer-columns-popover header small {
  margin-top: 3px;
  color: #898793;
  font-size: 0.64rem;
}

.explorer-columns-popover label {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 8px;
  border-radius: 8px;
  color: #494852;
  font-size: 0.7rem;
  cursor: pointer;
}

.explorer-columns-popover label:hover {
  background: #f7f5ff;
}

.explorer-columns-popover input {
  width: 15px;
  height: 15px;
  accent-color: #6547e8;
}

.explorer-table-pagination {
  display: inline-flex;
  min-height: 36px;
  align-items: center;
  overflow: hidden;
  border: 1px solid #e3e3eb;
  border-radius: 10px;
  background: #ffffff;
}

.explorer-table-pagination span {
  padding: 0 11px;
  color: #74727e;
  font-size: 0.67rem;
  font-weight: 700;
  white-space: nowrap;
}

.explorer-table-pagination button {
  width: 34px;
  min-height: 34px;
  border: 0;
  border-left: 1px solid #e8e8ee;
  background: #ffffff;
  color: #46444f;
  font-size: 1.05rem;
  cursor: pointer;
}

.explorer-table-pagination button:hover:not(:disabled) {
  background: #f7f5ff;
  color: #6547e8;
}

.explorer-table-pagination button:disabled {
  color: #c5c4cc;
  cursor: not-allowed;
}

.explorer-table .table-scroll {
  max-height: 575px;
  overflow: auto;
  border-top: 1px solid #e9e9ef;
  border-radius: 0 0 17px 17px;
}

.explorer-table table {
  width: 100%;
  min-width: max-content;
  border-collapse: separate;
  border-spacing: 0;
}

.explorer-table th,
.explorer-table td {
  min-width: 92px;
  padding: 11px 13px;
  border-bottom: 1px solid #eeeef3;
  white-space: nowrap;
}

.explorer-table th {
  position: sticky;
  z-index: 5;
  top: 0;
  background: #fafafe;
  color: #686672;
  font-size: 0.61rem;
  font-weight: 800;
  letter-spacing: 0.055em;
  text-transform: uppercase;
  box-shadow: inset 0 -1px #e5e5eb;
}

.explorer-table td {
  background: var(--explorer-row-background, #ffffff);
  color: #35343d;
  font-size: 0.72rem;
}

.explorer-table th[data-value-kind="number"],
.explorer-table td[data-value-kind="number"] {
  text-align: right;
  font-variant-numeric: tabular-nums;
}

.explorer-table tbody tr {
  --explorer-row-background: #ffffff;
  transition: background 140ms ease;
}

.explorer-table tbody tr:nth-child(even) {
  --explorer-row-background: #fdfdff;
}

.explorer-table tbody tr:hover {
  --explorer-row-background: #f8f6ff;
}

.explorer-table th[data-sticky-column],
.explorer-table td[data-sticky-column] {
  position: sticky;
}

.explorer-table th[data-sticky-column="0"],
.explorer-table td[data-sticky-column="0"] {
  left: 0;
  min-width: 112px;
}

.explorer-table th[data-sticky-column="1"],
.explorer-table td[data-sticky-column="1"] {
  left: 112px;
  min-width: 138px;
  box-shadow:
    1px 0 0 #ececf1,
    7px 0 12px rgb(20 20 30 / 3%);
}

.explorer-table th[data-sticky-column] {
  z-index: 8;
  background: #fafafe;
}

.explorer-table td[data-sticky-column] {
  z-index: 3;
}

.explorer-table td[data-missing="true"] {
  color: #a06b23;
  font-style: italic;
}

.explorer-treatment-pill {
  display: inline-flex;
  min-height: 22px;
  align-items: center;
  justify-content: center;
  padding: 0 8px;
  border-radius: 999px;
  font-size: 0.63rem;
  font-weight: 800;
  letter-spacing: 0.015em;
}

.explorer-treatment-pill[data-status="treated"] {
  background: #eee9ff;
  color: #6547e8;
}

.explorer-treatment-pill[data-status="control"] {
  background: #efeff3;
  color: #55535f;
}

@media (max-width: 900px) {
  .explorer-table-heading {
    flex-direction: column;
  }

  .explorer-table-toolbar {
    width: 100%;
    justify-content: flex-start;
    flex-wrap: wrap;
  }
}

@media (max-width: 620px) {
  .explorer-table-heading {
    padding-inline: 15px;
  }

  .explorer-table-pagination span {
    display: none;
  }

  .explorer-columns-popover {
    right: auto;
    left: 0;
  }
}
